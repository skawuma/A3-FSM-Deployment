DB_NAME=a3fsm
DB_USERNAME=a3fsm_app
DB_PASSWORD=replace-with-a-strong-database-password

APP_HOST=fsm.example.com
GRAFANA_HOST=grafana.example.com
ACME_EMAIL=admin@example.com

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace-with-a-strong-pgadmin-password

JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000
JWT_SECRET=replace-with-a-long-random-dev-secret
APP_CORS_ALLOWED_ORIGINS=https://fsm.example.com

SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

APP_AUTH_ALLOW_SELF_REGISTRATION=false
APP_AUTH_ALLOW_ADMIN_BOOTSTRAP=false
APP_AUTH_BOOTSTRAP_ADMIN_EMAIL=
APP_AUTH_BOOTSTRAP_ADMIN_PASSWORD=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
