DB_NAME=a3fsm
DB_USERNAME=a3fsm_app
DB_PASSWORD=replace-with-a-strong-database-password

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace-with-a-strong-pgadmin-password

JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000
JWT_SECRET=replace-with-a-long-random-dev-secret
APP_CORS_ALLOWED_ORIGINS=https://your-domain.example

SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
