DB_NAME=a3fsm
DB_USERNAME=a3fsm_app
DB_PASSWORD=replace-with-a-strong-database-password
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/a3fsm
SPRING_DATASOURCE_USERNAME=a3fsm_app
SPRING_DATASOURCE_PASSWORD=replace-with-a-strong-database-password

BACKEND_IMAGE=ghcr.io/skawuma/a3-fsm-backend:sprint-11-sla-intelligence
FRONTEND_IMAGE=ghcr.io/skawuma/a3-fsm-frontend:sprint-11-sla-intelligence

SPRING_PROFILES_ACTIVE=prod
DEMO_DATA_ENABLED=false

FSM_DOMAIN=fsm.example.com
GRAFANA_DOMAIN=grafana.example.com
ACME_EMAIL=admin@example.com

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace-with-a-strong-pgadmin-password

JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000
JWT_SECRET=replace-with-a-long-random-dev-secret
APP_CORS_ALLOWED_ORIGINS=https://fsm.example.com
CORS_ALLOWED_ORIGINS=https://fsm.example.com

SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

APP_AUTH_ALLOW_SELF_REGISTRATION=false
APP_AUTH_ALLOW_ADMIN_BOOTSTRAP=false
APP_AUTH_BOOTSTRAP_ADMIN_EMAIL=
APP_AUTH_BOOTSTRAP_ADMIN_PASSWORD=

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
